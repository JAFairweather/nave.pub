[Unit]
Description=Publish Nave relay effective writer set
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/nave.pub/deploy/relay
ExecStart=/usr/bin/python3 /root/nave.pub/deploy/relay/effective-writers.py --publish
TimeoutStartSec=120
NoNewPrivileges=true
