# Box-only, never committed.
# Comments sit on their own line: git reads "#" as a comment only at the start
# of a line, so a trailing comment becomes part of the pattern and matches nothing.

# Director secrets (ANTHROPIC_API_KEY, director nsec, ACME_EMAIL)
.env
# the platform secret bundle, decrypted from secrets/nave.enc.env at deploy time (nactor reads this — has the brokered creds)
nave.env
# nave.env with brokered creds stripped — what the consumers read
nave-consumer.env
# Nactor's own grantee key (NACTOR_NSEC), minted on the box by ops/gen-nactor-key.sh
nactor.env
# brain identity (BRAIN_NSEC) + NACT_BROKER_URL, minted on the box by ops/gen-brain-key.sh
brain.env
# James's Quill's key (QUILL_NSEC, npub13uuznpc) if running the interim box scribe — the Director's own key, provided by him, NEVER minted here
quill.env
quill-bunker.env
# box-local continuity ledger for luke-brain (proposed/approved/passed) — survives redeploys
brain-state/
# box-local pending-proposal store (pending.json) for luke-poster — survives redeploys
luke-state/
# the self-hosted openclaw service's env (ANTHROPIC_API_KEY, TZ) — box-local, no gateway token
openclaw.env
# migrated OpenClaw state (agents/memory/config), refreshed from live by ops/oc-resync-boot.sh
openclaw-state/
# the openclaw container's $HOME (/data): temp dir + pre-migration Git backups
openclaw-home/
# throwaway state copy for ops/oc-upgrade-test.sh (auto-removed; ignored in case a run is interrupted)
openclaw-upgradetest/
# box-local SSH deploy key for the private luke-brain backup repo (minted by ops/brain-backup-setup.sh)
luke-brain-deploy.key
# its public half (printed by setup to add as the repo's write deploy key)
luke-brain-deploy.key.pub
# box-local clone of the private luke-brain repo (encrypted brain snapshots pushed from here)
luke-brain-repo/
# fresh clones of every repo, synced by sites.sh
sites/
# Gmail app password for himalaya (box-local; ops/mail-setup.sh reads it)
luke-mail.env
# pinned static binaries mounted into the openclaw container (himalaya etc.)
openclaw-tools/
# generated by sites.sh: NVOY_NSEC (← NACTOR_NSEC) + NVOY_RELAYS — the nvoy-mcp service's key custody (M7)
nvoy-mcp.env
# box-local M7 cutover marker (ops/m7-cutover.sh); while present, sites.sh keeps NACTOR_NSEC out of nactor's envs
.m7-mcp-transport
.flipped
# timestamped backups of any of the above (env files, Caddyfile edits)
*.bak-*
*.before-*
waggle-wake-state/

# The nave-owned SOPS bundle: the ENCRYPTED file is committed (only the box can
# decrypt it); any PLAINTEXT temp created for a re-encrypt must never be.
secrets/*.env
secrets/*.tmp
secrets/*.plain*
!secrets/*.enc.env
waggle-wake.env
